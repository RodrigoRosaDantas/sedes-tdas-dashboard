{
  "schemaVersion": "2.0.0",
  "mode": "real-operations",
  "basePath": "/sedes-tdas-dashboard/",
  "sources": [
    "Controle de Questões TDAS",
    "Caderno de Erros TDAS / PRO",
    "Banco de Redações TDAS"
  ],
  "routes": [
    {
      "key": "estudar",
      "path": "/sedes-tdas-dashboard/estudar/",
      "title": "Central de estudo",
      "status": "Ativa",
      "source": "Snapshot validado dos três bancos oficiais"
    },
    {
      "key": "resolver",
      "path": "/sedes-tdas-dashboard/resolver/",
      "title": "Execução do dia",
      "status": "Alias para Hoje",
      "target": "/sedes-tdas-dashboard/hoje/"
    },
    {
      "key": "revisar",
      "path": "/sedes-tdas-dashboard/revisar/",
      "title": "Revisar",
      "status": "Alias para o caderno oficial",
      "target": "/sedes-tdas-dashboard/questoes-erros/"
    },
    {
      "key": "caderno-erros",
      "path": "/sedes-tdas-dashboard/caderno-erros/",
      "title": "Caderno de erros",
      "status": "Alias para o caderno oficial",
      "target": "/sedes-tdas-dashboard/questoes-erros/"
    },
    {
      "key": "desempenho",
      "path": "/sedes-tdas-dashboard/desempenho/",
      "title": "Desempenho",
      "status": "Alias para Evolução",
      "target": "/sedes-tdas-dashboard/evolucao/"
    },
    {
      "key": "fila-ia",
      "path": "/sedes-tdas-dashboard/fila-ia/",
      "title": "Auditoria",
      "status": "Alias para Auditoria",
      "target": "/sedes-tdas-dashboard/auditoria/"
    }
  ],
  "invariants": [
    "official-notion-sources-only",
    "no-question-bank-read",
    "no-question-catalog",
    "no-answer-key-load",
    "no-notion-writeback-from-site",
    "public-snapshot-read-only",
    "single-dashboard-service-worker"
  ]
}
