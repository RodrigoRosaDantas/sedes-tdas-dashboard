rídica ao original também depende dos requisitos técnicos, de integridade, confiabilidade, rastreabilidade e assinatura aplicáveis.","C":"A digitalização dispensa controle de autenticidade.","D":"Somente documentos permanentes podem ser digitalizados.","E":"Arquivos digitalizados não precisam de política de preservação."},"sourceCatalogId":"master:sim-emilia-2026-tdas-arq01","sourcePe":"Banco Mestre","sourceTitle":"Simulado ARQ01 — Arquivologia","sourceKeyPath":"data/integration/question-keys/master/sim-emilia-2026-tdas-arq01.json","sourcePublicPath":"data/integration/master-question-bank/sim-emilia-2026-tdas-arq01.json","sourceKind":"master-bank","materialId":"sim-emilia-2026-tdas-arq01","materialName":"Simulado ARQ01 — Arquivologia","tipoMaterial":"simulado","banca":"Emília Adelino","ano":2026,"orgao":"SEDES/DF","cargo":"TDAS — Técnico Administrativo","codigoCargo":"202","dificuldade":"","formatoQuestao":"","bloco":"","fonteConsolidada":null},{"id":"SIM-EMILIA-2026-TDAS-ARQ01-390","codigo":"SIM-EMILIA-2026-TDAS-ARQ01-390","numeroOriginal":390,"materia":"Arquivologia","assunto":"Noções de Arquivologia","subassunto":"","texto_base":null,"enunciado":"Sobre microfilmagem e digitalização, assinale a alternativa correta.","alternativas":{"A":"Somente o microfilme pode produzir efeitos jurídicos equivalentes ao original.","B":"O microfilme pode produzir os mesmos efeitos legais do original e permitir eliminação regulamentada do papel, excetuados documentos de valor histórico; documentos digitalizados também podem produzir efeitos equivalentes quando atendidos os requisitos legais e técnicos aplicáveis.","C":"Todo documento microfilmado deve ser eliminado, inclusive o de valor permanente.","D":"A digitalização não admite certificação de autenticidade.","E":"O microfilme dispensa indexação e controle arquivístico."},"sourceCatalogId":"master:sim-emilia-2026-tdas-arq01","sourcePe":"Banco Mestre","sourceTitle":"Simulado ARQ01 — Arquivologia","sourceKeyPath":"data/integration/question-keys/master/sim-emilia-2026-tdas-arq01.json","sourcePublicPath":"data/integration/master-question-bank/sim-emilia-2026-tdas-arq01.json","sourceKind":"master-bank","materialId":"sim-emilia-2026-tdas-arq01","materialName":"Simulado ARQ01 — Arquivologia","tipoMaterial":"simulado","banca":"Emília Adelino","ano":2026,"orgao":"SEDES/DF","cargo":"TDAS — Técnico Administrativo","codigoCargo":"202","dificuldade":"","formatoQuestao":"","bloco":"","fonteConsolidada":null}],"excludedAnnulled":[]}
