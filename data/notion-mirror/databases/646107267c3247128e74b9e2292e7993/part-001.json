ondentes às 361 questões aderentes, 75 corrigidas e 134 aperfeiçoadas. Próxima etapa operacional: conferência final transversal de gabaritos, comentários, códigos, duplicidades e distribuição das alternativas. Consultar AUD01 a AUD05, CORR01 a CORR05, APERF01 a APERF05 e CONSOL01 para a trilha completa de validação e aplicação."},"Questões estimadas":{"type":"number","value":570},"Tipo":{"type":"select","value":"Caderno autoral"},"Lote":{"type":"unique_id","value":"PDF1"},"Status":{"type":"select","value":"Concluído"},"Questões duplicadas":{"type":"number","value":null},"Tema predominante":{"type":"rich_text","value":"Conteúdo completo do cargo 202, organizado por tópicos do edital"},"Arquivo / lote":{"type":"title","value":"Caderno de Questões SEDES/DF — Técnico Administrativo — Emília Adelino"}}},{"id":"3a6cf5a2-6731-81ce-bc96-c848cde40a14","title":"RIDE e Realidade do DF — Lei Complementar nº 94/1998","url":"https://app.notion.com/p/RIDE-e-Realidade-do-DF-Lei-Complementar-n-94-1998-3a6cf5a2673181cebc96c848cde40a14","createdAt":"2026-07-23T21:57:00.000Z","lastEditedAt":"2026-07-23T21:57:00.000Z","properties":{"Prioridade":{"type":"select","value":"Alta"},"Conferência visual":{"type":"checkbox","value":false},"Bancas":{"type":"multi_select","value":["Cebraspe"]},"Última edição":{"type":"last_edited_time","value":"2026-07-23T21:57:00.000Z"},"Páginas":{"type":"number","value":8},"Questões incluídas":{"type":"number","value":null},"Entrada":{"type":"created_time","value":"2026-07-23T21:57:00.000Z"},"Período":{"type":"rich_text","value":"Diversos"},"Observações":{"type":"rich_text","value":"Lote curto e adequado para processamento prioritário após o piloto do caderno do cargo 202."},"Questões estimadas":{"type":"number","value":null},"Tipo":{"type":"select","value":"Compilação de questões"},"Lote":{"type":"unique_id","value":"PDF6"},"Status":{"type":"select","value":"Inventariado"},"Questões duplicadas":{"type":"number","value":null},"Tema predominante":{"type":"rich_t