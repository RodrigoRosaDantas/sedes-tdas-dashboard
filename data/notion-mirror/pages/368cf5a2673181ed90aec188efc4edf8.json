lic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Recorte: arts. 214 e 215","color":"default"},{"id":"0950fd9a-1918-42fe-85aa-dad5ff120fc7","type":"bulleted_list_item","hasChildren":false,"richText":[{"text":"Fonte oficial usada para transcrição: SINJ-DF — LC 840/2011 — texto compilado","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Fonte oficial usada para transcrição: SINJ-DF — LC 840/2011 — texto compilado","color":"default"},{"id":"c7af842e-d803-4da7-9e5b-8d8985851739","type":"divider","hasChildren":false},{"id":"31082640-76ae-43a3-8ae8-242947322e4e","type":"heading_1","hasChildren":false,"richText":[{"text":"Seção II","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Seção II","color":"default"},{"id":"3b8f230d-5284-426a-80d2-621550880961","type":"heading_1","hasChildren":false,"richText":[{"text":"Da Sindicância","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Da Sindicância","color":"default"},{"id":"75bef260-ed3d-4e2d-8d98-d20604794f7b","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 214. A sindicância é o procedimento investigativo destinado a:","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 214. A sindicância é o procedimento investigativo destinado a:","color":"default"},{"id":"1a79e234-ebf8-451a-b4c2-6b9a603b11e1","type":"paragraph","hasChildren":false,"richText":[{"text":"I – identificar a autoria de infração disciplinar, quando desconhecida;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"I – identificar a autoria de infração disciplinar, quando desconhecida;","color":"default"},{"id":"04d7348b-10eb-4032-bb7f-b8d0c3ce7b74","type":"paragraph","hasChildren":false,"richText":[{"text":"II – apurar a materialidade de infração disciplinar sobre a qual haja apenas indícios ou que tenha sido apenas noticiada.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"II – apurar a materialidade de infração disciplinar sobre a qual haja apenas indícios ou que tenha sido apenas noticiada.","color":"default"},{"id":"fb7b5803-9f91-486d-92d8-9ce10421b12b","type":"paragraph","hasChildren":false,"richText":[{"text":"§ 1º O ato de instauração da sindicância deve ser publicado no Diário Oficial do Distrito Federal.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"§ 1º O ato de instauração da sindicância deve ser publicado no Diário Oficial do Distrito Federal.","color":"default"},{"id":"1dbeb264-8ea8-448b-9036-fb7d664a30a3","type":"paragraph","hasChildren":false,"richText":[{"text":"§ 2º O prazo para conclusão da sindicância é de até trinta dias, prorrogável por igual período, a critério da autoridade competente.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"§ 2º O prazo para conclusão da sindicância é de até trinta dias, prorrogável por igual período, a critério da autoridade competente.","color":"default"},{"id":"e5d8cdc6-d54d-433f-8433-0cc823fbf56d","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 215. Da sindicância pode resultar:","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 215. Da sindicância pode resultar:","color":"default"},{"id":"1435b18c-8a24-4f95-97d2-07b360e29fbe","type":"paragraph","hasChildren":false,"richText":[{"text":"I – o arquivamento do processo;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"I – o arquivamento do processo;","color":"default"},{"id":"572c4a39-c775-4c37-8f91-fbe3ab3f1999","type":"paragraph","hasChildren":false,"richText":[{"text":"II – instauração de processo disciplinar;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"II – instauração de processo disciplinar;","color":"default"},{"id":"976e060b-967f-4aa2-8e16-6f43dde28f25","type":"paragraph","hasChildren":false,"richText":[{"text":"III – aplicação de sanção de advertência ou suspensão de até trinta dias.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"III – aplicação de sanção de advertência ou suspensão de até trinta dias.","color":"default"},{"id":"867616a9-951b-429a-900e-185042767ae1","type":"paragraph","hasChildren":false,"richText":[{"text":"§ 1º Constatado na sindicância que a infração classifica-se como leve ou média do grupo I, a comissão de sindicância deve citar o servidor acusado para acompanhar o prosseguimento da apuração nos mesmos autos.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"§ 1º Constatado na sindicância que a infração classifica-se como leve ou média do grupo I, a comissão de sindicância deve citar o servidor acusado para acompanhar o prosseguimento da apuração nos mesmos autos.","color":"default"},{"id":"1af8d1dc-ab47-4dac-ac62-e89f4d33c5d0","type":"paragraph","hasChildren":false,"richText":[{"text":"§ 2º Aplicam-se, a partir do ato processual de que trata o § 1º, as normas do processo disciplinar, incluídas as garantias ao contraditório e à ampla defesa e as normas relativas à comissão processante.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"§ 2º Aplicam-se, a partir do ato processual de que trata o § 1º, as normas do processo disciplinar, incluídas as garantias ao contraditório e à ampla defesa e as normas relativas à comissão processante.","color":"default"}],"children":[],"databases":[]}
