alse,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 1º A República Federativa do Brasil, formada pela união indissolúvel dos Estados e Municípios e do Distrito Federal, constitui-se em Estado democrático de direito e tem como fundamentos:","color":"default"},{"id":"d67dc1e4-c5a3-4bff-80c2-08af0d3866fb","type":"paragraph","hasChildren":false,"richText":[{"text":"I - a soberania;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"I - a soberania;","color":"default"},{"id":"3a60700a-c069-4f45-91f4-cd26b9eb7a57","type":"paragraph","hasChildren":false,"richText":[{"text":"II - a cidadania;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"II - a cidadania;","color":"default"},{"id":"5093044a-dbeb-43db-98ba-90204faca67b","type":"paragraph","hasChildren":false,"richText":[{"text":"III - a dignidade da pessoa humana;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"III - a dignidade da pessoa humana;","color":"default"},{"id":"8218138b-6ae6-415b-8022-dc38df9d0eb6","type":"paragraph","hasChildren":false,"richText":[{"text":"IV - os valores sociais do trabalho e da livre iniciativa;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"IV - os valores sociais do trabalho e da livre iniciativa;","color":"default"},{"id":"33fe7c13-1d68-4b43-af0f-4e4fb89b5f2b","type":"paragraph","hasChildren":false,"richText":[{"text":"V - o pluralismo político.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"V - o pluralismo político.","color":"default"},{"id":"52a6007c-9e64-4861-9aad-6c4c21f83b93","type":"paragraph","hasChildren":false,"richText":[{"text":"Parágrafo único. Todo o poder emana do povo, que o exerce por meio de representantes eleitos ou diretamente, nos termos desta Constituição.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Parágrafo único. Todo o poder emana do povo, que o exerce por meio de representantes eleitos ou diretamente, nos termos desta Constituição.","color":"default"},{"id":"f7a5124a-e7d6-4a12-bf28-b715d19417bf","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 2º São Poderes da União, independentes e harmônicos entre si, o Legislativo, o Executivo e o Judiciário.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 2º São Poderes da União, independentes e harmônicos entre si, o Legislativo, o Executivo e o Judiciário.","color":"default"},{"id":"995f3c62-7d5d-4c94-9536-dd7b7a1d2f7a","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 3º Constituem objetivos fundamentais da República Federativa do Brasil:","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 3º Constituem objetivos fundamentais da República Federativa do Brasil:","color":"default"},{"id":"07043da9-0e1c-473a-9a18-3b140a592dc8","type":"paragraph","hasChildren":false,"richText":[{"text":"I - construir uma sociedade livre, justa e solidária;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"I - construir uma sociedade livre, justa e solidária;","color":"default"},{"id":"4885045c-e6e1-4e90-9146-d335080aa890","type":"paragraph","hasChildren":false,"richText":[{"text":"II - garantir o desenvolvimento nacional;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"II - garantir o desenvolvimento nacional;","color":"default"},{"id":"751acec0-e456-4974-b9a9-2783427b4674","type":"paragraph","hasChildren":false,"richText":[{"text":"III - erradicar a pobreza e a marginalização e reduzir as desigualdades sociais e regionais;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"III - erradicar a pobreza e a marginalização e reduzir as desigualdades sociais e regionais;","color":"default"},{"id":"fe38c04c-04d7-4b0a-b937-eff93096d327","type":"paragraph","hasChildren":false,"richText":[{"text":"IV - promover o bem de todos, sem preconceitos de origem, raça, sexo, cor, idade e quaisquer outras formas de discriminação.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"IV - promover o bem de todos, sem preconceitos de origem, raça, sexo, cor, idade e quaisquer outras formas de discriminação.","color":"default"},{"id":"d23d93fb-7c4d-46fc-8b2f-a403e66aec74","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 4º A República Federativa do Brasil rege-se nas suas relações internacionais pelos seguintes princípios:","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 4º A República Federativa do Brasil rege-se nas suas relações internacionais pelos seguintes princípios:","color":"default"},{"id":"f1adac0c-9f0c-4c05-b1d0-9e569c570ca9","type":"paragraph","hasChildren":false,"richText":[{"text":"I - independência nacional;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"I - independência nacional;","color":"default"},{"id":"60ce6440-71e3-4134-be80-11c941b0c865","type":"paragraph","hasChildren":false,"richText":[{"text":"II - prevalência dos direitos humanos;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"II - prevalência dos direitos humanos;","color":"default"},{"id":"44979e62-7219-4918-bf10-eb38f8331902","type":"paragraph","hasChildren":false,"richText":[{"text":"III - autodeterminação dos povos;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"III - autodeterminação dos povos;","color":"default"},{"id":"a5d233f6-64b4-432f-9f23-ebdd49e76b90","type":"paragraph","hasChildren":false,"richText":[{"text":"IV - não-intervenção;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"IV - não-intervenção;","color":"default"},{"id":"133089e4-04cd-4d54-a76a-492e653edb2a","type":"paragraph","hasChildren":false,"richText":[{"text":"V - igualdade entre os Estados;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"V - igualdade entre os Estados;","color":"default"},{"id":"6aea4033-405b-4b72-97d0-38e0fcf16484","type":"paragraph","hasChildren":false,"richText":[{"text":"VI - defesa da paz;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"VI - defesa da paz;","color":"default"},{"id":"382c655d-5cb0-47d7-bd0d-37e94ddca31a","type":"paragraph","hasChildren":false,"richText":[{"text":"VII - solução pacífica dos conflitos;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"VII - solução pacífica dos conflitos;","color":"default"},{"id":"a3165189-2fcc-45d6-8b26-8f3380b8c98d","type":"paragraph","hasChildren":false,"richText":[{"text":"VIII - repúdio ao terrorismo e ao racismo;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"VIII - repúdio ao terrorismo e ao racismo;","color":"default"},{"id":"db9e5e5c-1ee0-49f9-b2b3-12d5199f5bdf","type":"paragraph","hasChildren":false,"richText":[{"text":"IX - cooperação entre os povos para o progresso da humanidade;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"IX - cooperação entre os povos para o progresso da humanidade;","color":"default"},{"id":"0257eea5-fede-475f-80a7-0e86f28c55a2","type":"paragraph","hasChildren":false,"richText":[{"text":"X - concessão de asilo político.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"X - concessão de asilo político.","color":"default"},{"id":"b3fc9d4f-4fd3-4a1d-a432-3892b00f9846","type":"paragraph","hasChildren":false,"richText":[{"text":"Parágrafo único. A República Federativa do Brasil buscará a integração econômica, política, social e cultural dos povos da América Latina, visando à formação de uma comunidade latino-americana de nações.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Parágrafo único. A República Federativa do Brasil buscará a integração econômica, política, social e cultural dos povos da América Latina, visando à formação de uma comunidade latino-americana de nações.","color":"default"},{"id":"b03587f4-94da-464c-a39e-75f3998e93b2","type":"divider","hasChildren":false},{"id":"02dfad80-76d8-4746-b987-eb01ff8fe775","type":"paragraph","hasChildren":false,"richText":[{"text":"Este texto não substitui o original publicado no Diário Oficial.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Este texto não substitui o original publicado no Diário Oficial.","col