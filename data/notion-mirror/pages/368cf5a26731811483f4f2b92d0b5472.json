"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Recorte: arts. 50 a 52","color":"default"},{"id":"c1f45558-03b3-4b71-8cc4-aa6c1593fd00","type":"bulleted_list_item","hasChildren":false,"richText":[{"text":"Fonte oficial usada para transcrição: SINJ-DF — LC 840/2011 — texto compilado","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Fonte oficial usada para transcrição: SINJ-DF — LC 840/2011 — texto compilado","color":"default"},{"id":"114987d3-c8ee-4542-ad90-c22464aa171b","type":"divider","hasChildren":false},{"id":"6116ef53-c4ae-4748-a61c-93aeeaeeaf25","type":"heading_1","hasChildren":false,"richText":[{"text":"CAPÍTULO V","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"CAPÍTULO V","color":"default"},{"id":"6acb0998-124f-4cb5-ab1f-012c03b548c5","type":"heading_1","hasChildren":false,"richText":[{"text":"DA VACÂNCIA","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"DA VACÂNCIA","color":"default"},{"id":"b3cf4f9b-212a-4bc8-a682-08fecdf48aae","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 50. A vacância do cargo público decorre de exoneração, demissão, destituição de cargo em comissão, aposentadoria, falecimento ou perda do cargo, nos demais casos previstos na Constituição Federal.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 50. A vacância do cargo público decorre de exoneração, demissão, destituição de cargo em comissão, aposentadoria, falecimento ou perda do cargo, nos demais casos previstos na Constituição Federal.","color":"default"},{"id":"0cd07753-6042-42d6-bc58-d8c8cd4cd8ca","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 51. A exoneração de cargo de provimento efetivo dá-se a pedido do servidor ou de ofício.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 51. A exoneração de cargo de provimento efetivo dá-se a pedido do servidor ou de ofício.","color":"default"},{"id":"bc2433a2-f7ca-4dc5-9721-8370265547ba","type":"paragraph","hasChildren":false,"richText":[{"text":"Parágrafo único. A exoneração de ofício dá-se, exclusivamente, quando o servidor for reprovado no estágio probatório ou, tendo tomado posse, não entrar em exercício no prazo estabelecido.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Parágrafo único. A exoneração de ofício dá-se, exclusivamente, quando o servidor for reprovado no estágio probatório ou, tendo tomado posse, não entrar em exercício no prazo estabelecido.","color":"default"},{"id":"4bec5517-5fc7-4994-9f29-a5396247e9f3","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 52. A exoneração de cargo em comissão dá-se a critério da autoridade competente ou a pedido do servidor.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 52. A exoneração de cargo em comissão dá-se a critério da autoridade competente ou a pedido do servidor.","color":"default"}],"children":[],"databases":[]}
