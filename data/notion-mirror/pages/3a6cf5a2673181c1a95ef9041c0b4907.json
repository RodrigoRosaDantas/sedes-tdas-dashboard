:false,"code":false,"color":"default"}},{"text":" 21 a 30","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Questões: 21 a 30","color":"default"},{"id":"8aa1b71f-0f8b-4961-b4e1-2716ee88fa77","type":"bulleted_list_item","hasChildren":false,"richText":[{"text":"Páginas das questões no PDF:","href":null,"annotations":{"bold":true,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}},{"text":" 8 a 10","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Páginas das questões no PDF: 8 a 10","color":"default"},{"id":"72c0aba6-a61c-4bdb-b526-5558fc08d97e","type":"bulleted_list_item","hasChildren":false,"richText":[{"text":"Páginas do gabarito comentado:","href":null,"annotations":{"bold":true,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}},{"text":" 14 e 15","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Páginas do gabarito comentado: 14 e 15","color":"default"},{"id":"554c3144-2a21-41d4-91c6-27a81857f74d","type":"quote","hasChildren":false,"richText":[{"text":"Transcrição do material fornecido. Grafia, redação, marcações e eventuais inconsistências foram preservadas conforme a fonte.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Transcrição do material fornecido. Grafia, redação, marcações e eventuais inconsistências foram preservadas conforme a fonte.","color":"default"},{"id":"4f6f8abb-8158-4492-a806-21d49406fde6","type":"heading_2","hasChildren":false,"richText":[{"text":"Texto de apoio para as questões de 01 a 40","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Texto de apoio para as questões de 01 a 40","color":"default"},{"id":"68b94959-2ece-4549-be73-019392e1ae12","type":"paragraph","hasChildren":false,"richText":[{"text":"A erradicação da extrema pobreza e o combate às desigualdades regionais configuram-se como desafios prementes para os gestores públicos no século XXI. Historicamente, a exclusão social no Brasil tendeu a se perpetuar devido à escassez de políticas de Estado que fossem, de fato, universais e descentralizadas. É crucial compreender que a vulnerabilidade não se restringe à ausência de renda; ela engloba, outrossim, a privação de acesso a serviços essenciais, como saúde, educação e acolhimento socioassistencial. Quando a Administração Pública negligencia tais demandas, ela joga à margem da sociedade contingentes humanos inteiros, alimentando um ciclo vicioso de violência e desamparo. Para reverter esse cenário complexo, o redesenho institucional deve priorizar a intersetorialidade, integrando diferentes secretarias e agentes comunitários. Somente por meio de uma ação coordenada, cuja execução seja transparente e fiscalizada, o Estado conseguirá resgatar a dignidade das famílias vulneráveis, transformando a assistência social em um vetor de emancipação humana real.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"A erradicação da extrema pobreza e o combate às desigualdades regionais configuram-se como desafios prementes para os gestores públicos no século XXI. Historicamente, a exclusão social no Brasil tendeu a se perpetuar devido à escassez de políticas de Estado que fossem, de fato, universais e descentralizadas. É crucial compreender que a vulnerabilidade não se restringe à ausência de renda; ela engloba, outrossim, a privação de acesso a serviços essenciais, como saúde, educação e acolhimento socioassistencial. Quando a Administração Pública negligencia tais demandas, ela joga à margem da sociedade contingentes humanos inteiros, alimentando um ciclo vicioso de violência e desamparo. Para reverter esse cenário complexo, o redesenho institucional deve priorizar a intersetorialidade, integrando diferentes secretarias e agentes comunitários. Somente por meio de uma ação coordenada, cuja execução seja transparente e fiscalizada, o Estado conseguirá resgatar a dignidade das famílias vulneráveis, transformando a assistência social em um vetor de emancipação humana real.","color":"default"},{"id":"9e4cc486-82dc-41f3-b3e8-8e2026775dfe","type":"heading_2","hasChildren":false,"richText":[{"text":"Questões","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Questões","color":"default"},{"id":"ed1eb7b2-9a32-4073-aa08-aed9cafe5db0","type":"heading_3","hasChildren":false,"richText":[{"text":"21","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"21","color":"default"},{"id":"db452721-cd98-463c-9eac-43dbe14c6dcb","type":"paragraph","hasChildren":false,"richText":[{"text":"No texto de apoio, a palavra \"erradicação\" é grafada com \"ç\" e o termo \"exclusão\" é grafado com \"s\". Assinale a alternativa em que todas as palavras estão ortograficamente corretas de acordo com a norma-padrão:","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"No texto de apoio, a palavra \"erradicação\" é grafada com \"ç\" e o termo \"exclusão\" é grafado com \"s\". Assinale a alternativa em que todas as palavras estão ortograficamente corretas de acordo com a norma-padrão:","color":"default"},{"id":"9d42a027-15b1-48b4-ac0e-7f4cfc514331","type":"paragraph","hasChildren":false,"richText":[{"text":"A) Compreenção, extinsão, excesso.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}