132","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Recorte: arts. 130 a 132","color":"default"},{"id":"97342ac5-60df-4d1b-a22c-b7aa1463a65f","type":"bulleted_list_item","hasChildren":false,"richText":[{"text":"Fonte oficial usada para transcrição: SINJ-DF — LC 840/2011 — texto compilado","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Fonte oficial usada para transcrição: SINJ-DF — LC 840/2011 — texto compilado","color":"default"},{"id":"958a72e7-9715-423d-996c-28f66baa79ea","type":"divider","hasChildren":false},{"id":"13e75602-51f8-4e35-899e-f30aad66db44","type":"heading_1","hasChildren":false,"richText":[{"text":"CAPÍTULO III","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"CAPÍTULO III","color":"default"},{"id":"7dc5c1e2-43f5-43da-95dc-0aaafa3f5860","type":"heading_1","hasChildren":false,"richText":[{"text":"DAS LICENÇAS","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"DAS LICENÇAS","color":"default"},{"id":"aef2c37a-19da-49ac-a365-20b16f854129","type":"heading_1","hasChildren":false,"richText":[{"text":"Seção I","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Seção I","color":"default"},{"id":"85c1566e-2d72-4910-9157-6675c25aeabb","type":"heading_1","hasChildren":false,"richText":[{"text":"Das Disposições Gerais","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Das Disposições Gerais","color":"default"},{"id":"d9cba342-d800-497c-b467-56d75f737922","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 130. Além do abono de ponto, o servidor faz jus a licença:","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 130. Além do abono de ponto, o servidor faz jus a licença:","color":"default"},{"id":"d5ae4c88-2285-4a01-9eaa-a8a7993db966","type":"paragraph","hasChildren":false,"richText":[{"text":"I – por motivo de afastamento do cônjuge ou companheiro;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"I – por motivo de afastamento do cônjuge ou companheiro;","color":"default"},{"id":"472c64a5-f379-4a64-a221-ea249cb77076","type":"paragraph","hasChildren":false,"richText":[{"text":"II – por motivo de doença em pessoa da família;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"II – por motivo de doença em pessoa da família;","color":"default"},{"id":"b2fd9db5-d80a-4377-b6b4-b5975f47dd70","type":"paragraph","hasChildren":false,"richText":[{"text":"III – para o serviço militar;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"III – para o serviço militar;","color":"default"},{"id":"f2f95df1-5a3b-47bc-85c9-6888c2dd9516","type":"paragraph","hasChildren":false,"richText":[{"text":"IV – para atividade política;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"IV – para atividade política;","color":"default"},{"id":"68ca2f72-ca40-4f63-85bf-31bea00fe94f","type":"paragraph","hasChildren":false,"richText":[{"text":"V - servidor;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"V - servidor;","color":"default"},{"id":"422ad3e2-2ff7-4194-919e-d10a75cd2a0a","type":"paragraph","hasChildren":false,"richText":[{"text":"VI – para tratar de interesses particulares;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"VI – para tratar de interesses particulares;","color":"default"},{"id":"de27485c-2083-46ce-ba41-1d12bd8564ef","type":"paragraph","hasChildren":false,"richText":[{"text":"VII – para desempenho de mandato classista;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"VII – para desempenho de mandato classista;","color":"default"},{"id":"26461efe-8ccf-4500-bcc4-7d051c39927c","type":"paragraph","hasChildren":false,"richText":[{"text":"VIII – paternidade;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"VIII – paternidade;","color":"default"},{"id":"fd221b26-865b-4473-9206-0899a634b422","type":"paragraph","hasChildren":false,"richText":[{"text":"IX – maternidade;","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"IX – maternidade;","color":"default"},{"id":"a2b09d02-19cd-4fe0-8c3d-028c6058e30f","type":"paragraph","hasChildren":false,"richText":[{"text":"X – médica ou odontológica.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"X – médica ou odontológica.","color":"default"},{"id":"13f0c25e-2055-4725-813f-dd8a0c29017b","type":"paragraph","hasChildren":false,"richText":[{"text":"XI – por até três dias consecutivos, a cada mês, em caso de sintomas graves associados ao fluxo menstrual, após homologação pela medicina ocupacional ou do trabalho.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"XI – por até três dias consecutivos, a cada mês, em caso de sintomas graves associados ao fluxo menstrual, após homologação pela medicina ocupacional ou do trabalho.","color":"default"},{"id":"76bd610c-9faa-4836-918e-1744e21b396b","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 131. A licença concedida dentro de sessenta dias do término de outra da mesma espécie é considerada como prorrogação.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 131. A licença concedida dentro de sessenta dias do término de outra da mesma espécie é considerada como prorrogação.","color":"default"},{"id":"72d4023d-a554-4da4-8c59-24d41e334b9b","type":"paragraph","hasChildren":false,"richText":[{"text":"Art. 132. Ao término das licenças previstas no art. 130, II a X, o servidor tem o direito de retornar à mesma lotação, com a mesma jornada de trabalho de antes do início da licença, desde que uma ou outra não tenha sofrido alteração normativa.","href":null,"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"}}],"text":"Art. 132. Ao término das licenças previstas no art. 130, II a X, o servidor tem o direito de retornar à mesma lotação, com a mesma jornada de trabalho de antes do início da licença, desde que uma ou outra não tenha sofrido alteração normativa.","color":"default"}],"children":[],"databases":[]}
